# 실제 API Key는 로컬 .env 파일에만 넣고 GitHub에 올리지 마세요.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TIMEOUT=60

# setup.bat에서 기본 데이터 경로를 준비합니다.
# 다른 위치를 사용할 경우 UI에서 직접 경로를 지정할 수 있습니다.
DATASET_ROOT=
OUTPUT_DIR=outputs

# 선택: 비용 추정용 단가(현재 OpenAI 가격에 맞게 직접 입력 권장)
OPENAI_INPUT_PRICE_PER_1M=0
OPENAI_OUTPUT_PRICE_PER_1M=0
