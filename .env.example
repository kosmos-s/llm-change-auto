# 실제 API Key는 로컬 .env 파일에만 넣고 GitHub에 올리지 마세요.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TIMEOUT=60

# 데이터셋 경로. 비워두면 기본값은 %USERPROFILE%\Desktop\산학과제\dataset_sample 입니다.
# 예: DATASET_ROOT=D:/ECTNFS_WSU/2026/dataset_sample
DATASET_ROOT=

# 본작업 목표와 안전장치
OPENAI_TARGET_TOTAL=3000
OPENAI_COST_LIMIT_USD=5
BACKUP_KEEP_COUNT=10

# 비용 추정용 현재 단가를 직접 입력하세요. 가격은 변경될 수 있어 기본값은 0입니다.
OPENAI_INPUT_PRICE_PER_1M=0
OPENAI_OUTPUT_PRICE_PER_1M=0

# 실행 결과는 저장소 루트의 outputs/ 아래에 저장됩니다.
